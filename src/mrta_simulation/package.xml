<?xml version="1.0"?>
<package format="2">
  <name>mrta_simulation</name>
  <version>0.1.0</version>
  <description>
    Week-1 ROS Noetic simulation for multi-robot task allocation with
    continuous vital-sign monitoring. Decision nodes are hardware-identical.
  </description>
  <maintainer email="arman@todo.todo">arman</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>mrta_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>mrta_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>
</package>
