Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /MarkerArray1
      Splitter Ratio: 0.5
    Tree Height: 800
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 5
        Y: 4
        Z: 0
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /visualization_marker_array
      Name: MarkerArray
      Namespaces:
        {}
      Queue Size: 10
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Color: 25; 255; 0
      Enabled: true
      Keep: 50
      Name: Robot0Odom
      Position Tolerance: 0.05
      Topic: /robot_0/odom
      Value: true
      Shape:
        Value: Arrow
    - Class: rviz/Odometry
      Color: 255; 85; 0
      Enabled: true
      Keep: 50
      Name: Robot1Odom
      Topic: /robot_1/odom
      Value: true
      Shape:
        Value: Arrow
    - Class: rviz/Odometry
      Color: 0; 170; 255
      Enabled: true
      Keep: 50
      Name: Robot2Odom
      Topic: /robot_2/odom
      Value: true
      Shape:
        Value: Arrow
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 14
      Focal Point:
        X: 4.5
        Y: 3.5
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
